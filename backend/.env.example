# FURKO Backend API - Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL & PostGIS Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=furko_db
DB_USER=furko_user
DB_PASSWORD=replace_with_your_secure_password

# Authentication (JWT)
JWT_SECRET=super_secret_furko_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
